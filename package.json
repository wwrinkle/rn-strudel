{
  "name": "rn-strudel",
  "version": "0.1.0",
  "description": "Strudel (strudel.cc) on React Native: superdough's worklet processors ported to real-time worklets and native C++ kernels, working delay/reverb, screen-lock-safe scheduling, on top of rn-web-audio-compat.",
  "license": "AGPL-3.0-or-later",
  "author": "Willie Wrinkle",
  "contributors": [
    "Claude (Anthropic) <noreply@anthropic.com>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wwrinkle/rn-strudel.git"
  },
  "homepage": "https://github.com/wwrinkle/rn-strudel#readme",
  "keywords": [
    "react-native",
    "strudel",
    "superdough",
    "tidalcycles",
    "live-coding",
    "web-audio"
  ],
  "main": "src/index.ts",
  "react-native": "src/index.ts",
  "browser": "src/index.web.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "browser": "./src/index.web.ts",
      "react-native": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./environment": {
      "browser": "./src/environment.web.ts",
      "react-native": "./src/environment.ts",
      "default": "./src/environment.ts"
    },
    "./processors": "./src/processors/index.ts",
    "./package.json": "./package.json"
  },
  "bin": {
    "rn-strudel-apply": "scripts/apply-native.js"
  },
  "files": [
    "src",
    "!src/**/__tests__",
    "native",
    "scripts",
    "docs",
    "COVERAGE.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "postinstall": "node scripts/apply-native.js",
    "test": "jest",
    "parity": "bash node_modules/rn-web-audio-compat/scripts/kernel-parity/run.sh src/__tests__/kernelParity.test.ts native/rnaa-0.13.5/files/common/cpp/audioapi/dsp/rnwac_ext",
    "typecheck": "cd example && npx tsc --noEmit",
    "coverage": "tsx scripts/gen-coverage.ts"
  },
  "dependencies": {
    "@strudel/core": "1.2.6",
    "@strudel/mini": "1.2.6",
    "@strudel/webaudio": "1.3.0",
    "superdough": "1.3.0"
  },
  "peerDependencies": {
    "react-native": "*",
    "react-native-audio-api": "0.13.5",
    "react-native-worklets": ">=0.10.1",
    "rn-web-audio-compat": "*"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-typescript": "^7.26.0",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "rn-web-audio-compat": "github:wwrinkle/rn-web-audio-compat",
    "tsx": "^4.23.15"
  }
}
